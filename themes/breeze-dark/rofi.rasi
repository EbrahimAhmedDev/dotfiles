* {
    bg: rgba(32, 35, 38, 0.96);
    bg-alt: rgba(41, 44, 48, 0.92);
    fg: #fcfcfc;
    accent: #3daee9;
    border-color: rgba(61, 174, 233, 0.35);
}

window {
    transparency: "real";
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    width: 480px;
    location: center;
    anchor: center;
    x-offset: 0;
    y-offset: 0;
}

mainbox {
    background-color: transparent;
    orientation: vertical;
    children: [ inputbar, listview ];
    padding: 14px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 0px 0px 12px 0px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    enabled: true;
    padding: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: rgba(161, 169, 177, 0.7);
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
    padding: 0px;
}

element {
    background-color: transparent;
    text-color: @fg;
    orientation: horizontal;
    border-radius: 6px;
    padding: 8px 10px;
}

element selected.normal {
    background-color: @accent;
    text-color: #fcfcfc;
}

element-icon {
    background-color: transparent;
    size: 22px;
    cursor: inherit;
    margin: 0px 10px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
}
