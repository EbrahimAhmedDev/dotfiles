# ~/.config/mako/config

# --- Position and layout ---
anchor=top-right
layer=overlay
width=360
height=140
margin=40,12,12,12
padding=12
max-visible=4
sort=-time
group-by=app-name

# --- Look ---
font=JetBrainsMono Nerd Font 11
background-color=#18181bee
text-color=#e4e4e7
border-color=#b388ff
border-size=1
border-radius=10
progress-color=over #b388ffaa

# --- Icons ---
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=8

# --- Content ---
markup=1
actions=1
format=<b>%s</b>\n%b

# --- Behavior ---
default-timeout=5000
ignore-timeout=0
history=1
max-history=50

# --- Mouse ---
on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

# --- Urgency levels ---
[urgency=low]
border-color=#52525b
default-timeout=3000

[urgency=high]
border-color=#ff5252
default-timeout=0

# --- Do not disturb: toggle with `makoctl mode -t do-not-disturb` ---
[mode=do-not-disturb]
invisible=1
